# Copy to .env.local and fill in. .env.local is gitignored and is read ONLY by
# the Vite dev server process — keys are injected into upstream requests by the
# proxy and never reach the browser bundle.

# Shodan (https://account.shodan.io) — powers the Infrastructure Recon panel.
# Without it that panel runs in query-builder mode instead of live lookups.
SHODAN_API_KEY=

# Optional. Everything else in this app works keyless.
# OpenSanctions (https://www.opensanctions.org/api/)
OPENSANCTIONS_API_KEY=
