          <section id="about" class="py-6 social-section">
    <div class="container">
        <div class="row align-items-end mb-5 g-3">
            <div class="col-md-8">
                <h6 class="accent-header">Social Media</h6>
                <h2 class="display-6 fw-bold mb-2">Featured News</h2>
                <p class="text-muted mb-0">Follow the FBI and FBI Director Kash Patel on X for the latest news, alerts, and updates.</p>
            </div>
            <div class="col-md-4 text-md-end d-flex flex-column align-items-md-end gap-2">
                <a href="https://x.com/FBI" target="_blank" rel="noopener" class="btn btn-sm px-3 social-follow-btn safe">
                    <i class="bi bi-twitter-x me-1" aria-hidden="true"></i>
