		<div class="main-wrapper">
			<h1 class="sr-only">FBI Homepage</h1>

			<div class="above-content-wrapper">
				
  <!-- Breaking News -->
  


				

				<!-- b/w compatible here... Everything this is useful in this manager should
         be moved to a tile -->
				
				
			</div>

			<div class="row main-content main-content col-count-1" id="main-content-container" dynamic-grid>
				<section id="main-content" col-count-1="12" col-count-2="9" col-count-3="6" class="col-md-12">
					<div data-panel="content" data-max-columns="4">
      <div class="mosaic-grid-row row">
        <div class="mosaic-grid-cell mosaic-width-full mosaic-position-leftmost col-md-12">
          <div class="movable removable mosaic-tile mosaic-fbigov.theme.video_hero-tile">
          <div class="mosaic-tile-content">
          <div>
<div class="page-hero-bg">
    <video class="hero-video hidden" autoplay muted loop playsinline aria-hidden="true" id="hero-video">
        <!--<source tal:attributes="src string: https://www.fbi.gov/fbi-homepage/hero" type="video/mp4">-->
    </video>
    <img class="hero-video" src="https://www.fbi.gov/image-repository/hero.jpg" id="placeholder-img">

    <!-- Hero -->
    <header id="home" class="hero">
        <div class="container">
            <h1 class="hero-headline">
                <span class="hero-reveal hero-reveal--1">
                    MISSION FIRST
                </span>
                <span class="hero-subheadline hero-reveal hero-reveal--2">
                    Since 1908, the FBI has protected the American people and upheld the U.S. Constitution.
                </span>
            </h1>
        </div>
    </header>
    <script>
        // Load video and once it's loaded replace placeholder image with the loaded video
        window.addEventListener(
            'load',
            () => {
                const placeholderImage = document.getElementById('placeholder-img');
                const video = document.getElementById('hero-video');

                const videoSrc = "https://www.fbi.gov/fbi-homepage/hero";

                video.src = videoSrc;

                video.load();

                video.addEventListener( 'canplaythrough', () => {
                    placeholderImage.classList.add( 'hidden' );
                    video.classList.remove( 'hidden' );
                    video.play().catch( error => {
                        console.log( "Autoplay blocked by browser. User must click to play.", error );
                    } );
                },
                    { once: true },
                );
            } );
    </script>
</div>


</div>

